<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/surface_white" android:padding="14dp" android:layout_marginBottom="4dp">
    <TextView android:id="@+id/textRecipeName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" tools:text="Bunny Chow"/>
    <TextView android:id="@+id/textRecipeSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="13sp" android:layout_marginTop="2dp" tools:text="Missing: Curry powder"/>
</LinearLayout>