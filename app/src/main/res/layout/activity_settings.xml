<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/cream_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@color/sun_yellow" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="16dp">
        <TextView android:id="@+id/buttonBack" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="←" android:textSize="24sp" android:textColor="@color/text_primary" android:textStyle="bold" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true" android:contentDescription="Back"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/title_settings" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" android:paddingVertical="16dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@color/surface_white" android:padding="16dp" android:layout_marginTop="4dp" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Expiring-soon alerts" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Highlight pantry items nearing their expiry date" android:textColor="@color/text_secondary" android:textSize="13sp"/>
        </LinearLayout>
        <Switch android:id="@+id/switchExpiryAlerts" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@color/surface_white" android:padding="16dp" android:layout_marginTop="4dp" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Prefer metric units" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Show g/ml/kg first when adding ingredients" android:textColor="@color/text_secondary" android:textSize="13sp"/>
        </LinearLayout>
        <Switch android:id="@+id/switchMetricUnits" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>